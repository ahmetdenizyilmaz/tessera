@@ -0,0 +1,90 @@
+use super::*;
+use crate::custom_terminal::Terminal;
+use pretty_assertions::assert_eq;
+use ratatui::backend::CrosstermBackend;
+use ratatui::layout::Position;
+use ratatui::layout::Rect;
+
+#[derive(Default)]
+struct Output {
+    bytes: Vec<u8>,
+    calls: usize,
+    fail: bool,
+}
+
+impl Write for Output {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.calls += 1;
+        if self.fail {
+            return Err(io::Error::from(io::ErrorKind::BrokenPipe));
+        }
+        self.bytes.extend_from_slice(bytes);
+        Ok(bytes.len())
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+#[test]
+fn long_history_preserves_every_row_with_bounded_console_writes() {
+    for mode in [InsertHistoryMode::Standard, InsertHistoryMode::FullScreen] {
+        let size = Size::new(/*width*/ 80, /*height*/ 24);
+        let mut terminal = Terminal::with_screen_size_and_cursor_position_for_test(
+            CrosstermBackend::new(Output::default()),
+            size,
+            Position::new(/*x*/ 0, /*y*/ 23),
+        );
+        terminal.set_viewport_area(Rect::new(
+            /*x*/ 0, /*y*/ 23, /*width*/ 80, /*height*/ 1,
+        ));
+        let lines = (0..2500)
+            .map(|i| HyperlinkLine::new(Line::from(format!("history row {i:04}"))))
+            .collect::<Vec<_>>();
+        insert_history_hyperlink_lines_with_mode_and_wrap_policy(
+            &mut terminal,
+            &lines,
+            mode,
+            HistoryLineWrapPolicy::PreWrap,
+            size,
+        )
+        .expect("insert complete history");
+        let output = terminal.backend().writer();
+        let bytes = String::from_utf8(output.bytes.clone()).expect("UTF-8 output");
+        let mut remaining = bytes.as_str();
+        for i in 0..2500 {
+            let marker = format!("history row {i:04}");
+            let (_, tail) = remaining.split_once(&marker).expect("all rows in order");
+            remaining = tail;
+        }
+        assert!(
+            output.calls < 20,
+            "unexpected per-line writes: {}",
+            output.calls
+        );
+        assert!(
+            bytes.ends_with("\x1b[24;1H"),
+            "cursor must be restored before returning"
+        );
+    }
+}
+
+#[test]
+fn buffered_history_reports_write_failures() {
+    let size = Size::new(/*width*/ 80, /*height*/ 24);
+    let mut terminal = Terminal::with_screen_size_and_cursor_position_for_test(
+        CrosstermBackend::new(Output {
+            fail: true,
+            ..Output::default()
+        }),
+        size,
+        Position::new(/*x*/ 0, /*y*/ 23),
+    );
+    terminal.set_viewport_area(Rect::new(
+        /*x*/ 0, /*y*/ 23, /*width*/ 80, /*height*/ 1,
+    ));
+    let error = insert_history_lines(&mut terminal, vec![Line::from("history")])
+        .expect_err("buffered writes must not fail silently on drop");
+    assert_eq!(error.kind(), io::ErrorKind::BrokenPipe);
+}
